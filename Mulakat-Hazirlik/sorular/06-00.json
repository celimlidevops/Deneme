  "sorular": [
    {
      "soru": "Kısa devre hesabı asıl ne için yapılır?",
      "secenekler": [
        "Yarınki hava için",
        "Kesici, koruma, ekipman zorlaması için",
        "Yalnız fatura için",
        "Yalnız boya rengi için"
      ],
      "dogru": 1,
      "neden": "Yük akışının yerine geçmez; arıza anı içindir."
    },
    {
      "soru": "En sık görülen arıza türü hangisidir?",
      "secenekler": [
        "Üç faz",
        "Tek faz-toprak",
        "İki faz",
        "Hiç arıza olmaz"
      ],
      "dogru": 1,
      "neden": "En büyük her zaman üç faz değildir."
    },
    {
      "soru": "Tek faz-toprak arızada diziler nasıl bağlanır?",
      "secenekler": [
        "Yalnız artı",
        "Artı, eksi ve sıfır seri",
        "Yalnız sıfır",
        "Hiç bağlanmaz"
      ],
      "dogru": 1,
      "neden": "Simetrik bileşenlerin klasik kuralı."
    },
    {
      "soru": "Generatör arıza akımı zamanla ne olur?",
