        "Hep aynı kalır",
        "İlk anda en büyük, sonra azalır",
        "Sıfırdan başlar sonsuza gider",
        "Yalnız gece akar"
      ],
      "dogru": 1,
      "neden": "Alt geçici → geçici → sürekli."
    },
    {
      "soru": "Kesici seçiminde yalnız etkin akım yeter mi?",
      "secenekler": [
        "Evet, tek sayı yeter",
        "Hayır; tepe ve X/R de önemli",
        "Kesici seçilmez",
        "Yalnız renk önemli"
      ],
      "dogru": 1,
      "neden": "DC bileşen tepeyi şişirir."
    },
    {
      "soru": "IEC 60909 nedir?",
      "secenekler": [
        "Bir trafo markası",
        "Kısa devre akımı hesabı standardı",
        "Bir fider tipi",
        "Bir sayaç protokolü"
      ],
      "dogru": 1,
      "neden": "Hangi standardı kullandığını söylemek önemli."
    },
    {
      "soru": "Eviricinin kısa devre katkısı senkron makine gibi midir?",
      "secenekler": [
        "Evet, aynı",
        "Hayır; sınırlı ve kontrollüdür",
        "Evirici hiç katkı vermez",
        "Yalnız 400 kV'ta aynıdır"
      ],
      "dogru": 1,
      "neden": "Klasik makine formülü dağıtım eviricisinde yanıltır."
    },
    {
      "soru": "Yazılımda tek faz akımı sıfır çıkıyorsa sık neden?",
      "secenekler": [
        "Ekran bozuk",
        "Sıfır dizi yolu / trafo grubu / nötr toprağı yanlış",
        "Frekans 50 değil",
        "Hava güneşli"
      ],
      "dogru": 1,
      "neden": "Z0 ve bağlantı grubu kritik veri."
    },
    {
      "soru": "Çok zayıf bara neden sorun?",
      "secenekler": [
        "Arıza akımı küçük → röle görmeyebilir",
        "Daha ucuz olduğu için",
        "Frekans yükselir",
        "Hiç sorun değil"
      ],
      "dogru": 0,
      "neden": "Sert bara da kesiciyi zorlar; ikisi de ayrı sorun."
